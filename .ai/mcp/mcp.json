{
  "mcpServers": {
    "laravel-boost": {
      "command": "/usr/bin/php",
      "args": [
        "/var/www/vhosts/tallypal/artisan",
        "boost:mcp"
      ]
    },
    "shadcn": {
      "command": "npx",
      "args": [
        "shadcn-vue@latest",
        "mcp"
      ]
    },
    "nightwatch": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://nightwatch.laravel.com/mcp"
      ]
    }
  }
}