{
    "mcpServers": {
        "laravel-boost": {
            "command": "php",
            "args": [
                "artisan",
                "boost:mcp"
            ]
        },
        "shadcn": {
            "command": "npx",
            "args": [
                "shadcn-vue@latest",
                "mcp"
            ]
        },
        "nightwatch": {
            "type": "http",
            "url": "https://nightwatch.laravel.com/mcp"
        },
        "phpstorm": {
            "url": "http://127.0.0.1:64442/stream",
            "type": "http"
        }
    }
}