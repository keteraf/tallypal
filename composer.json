{
    "schema": "https://getcomposer.org/schema.json",
    "name": "keteraf/tallypal",
    "type": "project",
    "description": "Personal finance tracker web app.",
    "keywords": [
        "finance",
        "tally",
        "money",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-pdo": "*",
        "doctrine/dbal": "^4.4",
        "inertiajs/inertia-laravel": "^3.0",
        "laravel/framework": "^13.0",
        "laravel/nightwatch": "^1.24",
        "laravel/pulse": "^1.4",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^3.0",
        "laravel/wayfinder": "^0.1.12",
        "nunomaduro/essentials": "^1.0",
        "spatie/laravel-permission": "^6.24"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.5",
        "fakerphp/faker": "^1.23",
        "laramint/laravel-brain": "^2.2",
        "larastan/larastan": "^3.0",
        "laravel/boost": "^2.0",
        "laravel/pail": "^1.2.2",
        "laravel/pao": "^1.1",
        "laravel/pint": "^1.18",
        "laravel/sail": "^1.41",
        "laravel/telescope": "^5.15",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^5",
        "pestphp/pest-plugin-browser": "^5.0",
        "pestphp/pest-plugin-laravel": "^5",
        "rector/rector": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan ide-helper:generate",
            "@php artisan boost:update --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "dev:ssr": [
            "npm run build:ssr",
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"php artisan inertia:start-ssr\" --names=server,queue,logs,ssr --kill-others"
        ],
        "fresh": [
            "@php artisan optimize:clear",
            "@php artisan logs:clear"
        ],
        "fresh:with-db": [
            "@php artisan migrate:fresh",
            "@fresh"
        ],
        "db:pgsql:up": [
            "podman container exists tallypal-pg-test || podman run -d --rm --name tallypal-pg-test -p 127.0.0.1:54329:5432 -e POSTGRES_USER=postgres -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=tallypal_test --mount type=tmpfs,destination=/var/lib/postgresql,tmpfs-size=2g docker.io/library/postgres:18 -c fsync=off -c synchronous_commit=off -c full_page_writes=off -c max_connections=200",
            "for i in $(seq 1 60); do podman exec tallypal-pg-test pg_isready -q -h 127.0.0.1 -U postgres && exit 0; sleep 0.5; done; echo 'tallypal-pg-test did not become ready' >&2; exit 1",
            "podman exec tallypal-pg-test psql -U postgres -tAc \"select 1 from pg_database where datname = 'tallypal'\" | grep -q 1 || podman exec tallypal-pg-test createdb -U postgres tallypal"
        ],
        "db:pgsql:down": "podman container exists tallypal-pg-test && podman stop tallypal-pg-test || true",
        "lint": "pint",
        "refactor": "rector",
        "test:lint": "pint --test",
        "test:refactor": "rector --dry-run",
        "test:types": "phpstan analyse --memory-limit 512M",
        "test:base": "rm -f vendor/pestphp/pest/.temp/only.lock && XDEBUG_MODE=coverage pest --no-tia --colors=always --parallel @additional_args",
        "test:fast": "rm -f vendor/pestphp/pest/.temp/only.lock && XDEBUG_MODE=coverage pest --tia --colors=always --parallel @additional_args",
        "test:browser": "rm -f vendor/pestphp/pest/.temp/only.lock && pest --no-tia --colors=always tests/Browser @additional_args",
        "test:unit": "@test:base --coverage --min=90",
        "test:mutate": "rm -f vendor/pestphp/pest/.temp/only.lock && DB_CONNECTION=sqlite DB_DATABASE=:memory: XDEBUG_MODE=coverage pest --no-tia --colors=always --parallel --mutate --min=100 @additional_args",
        "test": [
            "@php artisan config:clear --ansi",
            "@test:lint",
            "@test:refactor",
            "@test:types",
            "@test:unit"
        ],
        "check": "@php tests/gate.php fast",
        "check:full": "@php tests/gate.php full"
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/telescope"
            ]
        }
    },
    "config": {
        "process-timeout": 0,
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
